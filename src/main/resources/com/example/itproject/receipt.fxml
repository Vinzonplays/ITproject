<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.ListView?>
<VBox spacing="10" alignment="CENTER" style="-fx-padding: 20;" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.itproject.Controller.ReceiptController">
    <Label text="KUSINA SA PIKAS ISKENA" style="-fx-font-size: 18; -fx-font-weight: bold;" />
    <Label text="ACLC Bukidnon P-13 Hagkol Valencia City Bukidnon 8709" />
    <Separator />

    <GridPane hgap="10" vgap="5">
        <Label text="Receipt #:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <Label fx:id="receiptNumberLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" />
        <Label text="Order #:" GridPane.rowIndex="0" GridPane.columnIndex="2" />
        <Label fx:id="orderNumberLabel" GridPane.rowIndex="0" GridPane.columnIndex="3" />

        <Label text="Cashier:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <Label fx:id="cashierNameLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" />
        <Label text="Order Type:" GridPane.rowIndex="1" GridPane.columnIndex="2" />
        <Label fx:id="orderTypeLabel" GridPane.rowIndex="1" GridPane.columnIndex="3" />
    </GridPane>

    <Separator />

    <Label text="Items:" style="-fx-font-weight: bold;" />
    <ListView fx:id="itemsListView" prefHeight="200" />

    <Separator />

    <GridPane hgap="10" vgap="5">
        <Label text="Total:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <Label fx:id="totalLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" />
        <Label text="Cash:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <Label fx:id="cashLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" />
        <Label text="Change:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
        <Label fx:id="changeLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" />
        <Label text="Payment Method:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
        <Label fx:id="paymentMethodLabel" GridPane.rowIndex="3" GridPane.columnIndex="1" />
    </GridPane>

    <Separator />

    <Label fx:id="dateTimeLabel" />
    <Label text="THANK YOU FOR DINING WITH US!" style="-fx-font-weight: bold;" />
</VBox>
