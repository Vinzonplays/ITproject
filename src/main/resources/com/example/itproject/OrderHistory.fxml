<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="paatPane" prefHeight="501.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.itproject.Controller.OrderHistoryController">

    <center>
        <AnchorPane prefHeight="538.0" prefWidth="600.0">
            <children>
                <HBox layoutY="6.0" prefHeight="29.0" prefWidth="600.0" spacing="10">
                    <children>
                        <Label text="Update Report: ">
                            <font>
                                <Font name="Bookman Old Style" size="13.0" />
                            </font>
                            <HBox.margin>
                                <Insets left="5.0" top="5.0" />
                            </HBox.margin>
                        </Label>
                        <ComboBox fx:id="filterComboBox" prefWidth="150">
                     <HBox.margin>
                        <Insets right="2.0" />
                     </HBox.margin></ComboBox>
                        <Button onAction="#handleFilterSelection" text="Generate" />
                  <DatePicker fx:id="si_Datepicker" onAction="#onDatePicker">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </DatePicker>
                    </children>
                </HBox>

                <TableView fx:id="adminTableview" layoutX="3.2" layoutY="34.4" prefHeight="372.0" prefWidth="590.0" AnchorPane.bottomAnchor="-2.0" AnchorPane.leftAnchor="3.0" AnchorPane.rightAnchor="7.0" AnchorPane.topAnchor="34.0">
                    <columns>
                        <TableColumn fx:id="adminProductId" prefWidth="125.0" text="Product ID" />
                        <TableColumn fx:id="adminProductName" prefWidth="125.0" text="Product Name" />
                        <TableColumn fx:id="adminCashier" prefWidth="125.0" text="Cashier Name" />
                        <TableColumn fx:id="adminQuantity" prefWidth="125.0" text="Quantity" />
                        <TableColumn fx:id="adminDineINTakeOut" prefWidth="125.0" text="Dine In/Take Out" />
                        <TableColumn fx:id="adminPrice" prefWidth="125.0" text="Price" />
                        <TableColumn fx:id="adminTotal" prefWidth="125.0" text="Total" />
                        <TableColumn fx:id="adminDateTime" prefWidth="125.0" text="Date &amp; Time" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </AnchorPane>
    </center>

    <top>
        <HBox prefHeight="59.0" prefWidth="1050.0" style="-fx-background-color: linear-gradient(to right, #2c3e50, #3498db);">
            <children>
                <Label prefHeight="42.0" prefWidth="178.0" text="Admin History" textFill="WHITE">
                    <font>
                        <Font name="Bookman Old Style Bold" size="20.0" />
                    </font>
                    <HBox.margin>
                        <Insets left="20.0" top="10.0" />
                    </HBox.margin>
                </Label>
                <Button fx:id="si_History" mnemonicParsing="false" onAction="#onHistory" prefHeight="40.0" prefWidth="118.0" style="-fx-background-color: FF9F00; -fx-background-radius: 10;" text="History" textFill="#fffcfc">
                    <font>
                        <Font name="Bookman Old Style Bold" size="18.0" />
                    </font>
                    <HBox.margin>
                        <Insets left="20.0" top="10.0" />
                    </HBox.margin>
                </Button>
                <Button fx:id="si_Inventory" mnemonicParsing="false" onAction="#onInventory" prefHeight="40.0" prefWidth="136.0" style="-fx-background-color: FF9F00; -fx-background-radius: 10;" text="Inventory" textFill="#fffcfc">
                    <HBox.margin>
                        <Insets left="20.0" top="10.0" />
                    </HBox.margin>
                    <font>
                        <Font name="Bookman Old Style Bold" size="18.0" />
                    </font>
                </Button>
                <Button fx:id="si_Logout" mnemonicParsing="false" onAction="#OnLogout" prefHeight="40.0" prefWidth="118.0" style="-fx-background-color: FF9F00; -fx-background-radius: 10;" text="Logout" textFill="#fff9f9">
                    <HBox.margin>
                        <Insets left="20.0" top="10.0" />
                    </HBox.margin>
                    <font>
                        <Font name="Bookman Old Style Bold" size="18.0" />
                    </font>
                </Button>
            </children>
        </HBox>
    </top>
   <bottom>

          <HBox alignment="CENTER_RIGHT" prefHeight="38.0" prefWidth="586.0" spacing="10" style="-fx-padding: 10;" BorderPane.alignment="CENTER">
              <children>
                  <Label text="Total Sales:" />
                  <Label fx:id="totalSalesLabel" style="-fx-font-weight: bold;" text="₱0.00" />
              </children>
          </HBox>
   </bottom>

</BorderPane>
