<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="953.0" prefWidth="1355.0" style="-fx-background-color: linear-gradient(to right, #2c3e50, #3498db);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.itproject.Controller.AdminLoginController">
   <children>
      <Pane prefHeight="251.0" prefWidth="116.0">
         <children>
              <VBox alignment="CENTER" layoutX="678.0" layoutY="1.0" prefHeight="250" prefWidth="300" spacing="15" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 5);">
                  <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Admin Login" />
      
                  <TextField fx:id="usernameField" promptText="Username" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-padding: 5;" />
                  <PasswordField fx:id="passwordField" promptText="Password" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-padding: 5;" />
      
                  <Button onAction="#handleLogin" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold;" text="Login" />
      
                  <Label fx:id="errorLabel" style="-fx-font-size: 12px;" textFill="red" />
              </VBox>
         </children>
      </Pane>
   </children>
</VBox>
